NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
CSRF_SIGNING_SECRET=replace-with-at-least-32-random-bytes
CRON_SECRET=replace-with-at-least-32-random-bytes
INTERNAL_AUTH_EMAIL_DOMAIN=auth.invalid
# Server-only. Pepper derives the Auth password and keys rate-limit/audit hashes (LA-ACC-005). Rotating it resets every student.
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-bytes
# Server-only shared student password (LA-ACC-003). Set in the deployment environment, never in the repository.
ROSTER_DEFAULT_PASSWORD=set-in-deployment-environment
# Optional until the real class file is inspected (N6). Leave empty for the minimal safety checks only.
ROSTER_STUDENT_ID_PATTERN=
ROSTER_MAX_ROWS=
# Trusted reverse proxies in front of the app, for the per-IP sign-in limit. Blank = 1 on Vercel, 0 elsewhere.
# With 0 the X-Forwarded-For header is ignored (it is client-controlled) and no per-IP limit applies.
TRUSTED_PROXY_HOPS=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

